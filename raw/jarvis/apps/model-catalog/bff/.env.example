PORT=3001
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://user:password@localhost:5432/jarvis
DATABASE_SSL=false

ROBERTO_BASE_URL=http://localhost:4000
PICASSO_URL=http://localhost:5000/classes
TASK_MANAGER_URL=http://localhost:6000

OTHER_CATEGORY_KEY=other

JWT_SECRET=SECRET_HERE
MAX_COOKIE_SIZE=4000

USER_ID=example@example.com
DISABLE_ADFS_AUTH=true
MAX_ADFS_LOGIN_ATTEMPTS=3
ADFS_PRODUCTION_URL=https://adfs.example.com/login

SENSOR_GROUP_LABELS={"day_group":"קבוצת יום","night_group":"קבוצת לילה","all_weather_group":"קבוצת כל מזג אוויר"}
GEOGRAPHY_LABELS={"north":"צפון","south":"דרום","center":"מרכז"}
GEOGRAPHY_LABEL_SINGULAR=אזור
GEOGRAPHY_LABEL_PLURAL=אזורים
PINNED_GEOGRAPHY=center
RESOLUTION_OPTIONS={"day_group":[256,512,1024],"night_group":[128,256],"all_weather_group":[256,512,1024,2048]}
RESOLUTION_UNIT=ס״מ

ADFS_STUB_DISPLAY_NAME=yonatan
ADFS_STUB_FULL_NAME=some random name
ADFS_STUB_HIERARCHY=jarvis/123
ADFS_STUB_EMAIL=test@test.com
