{
  "name": "<%= contractProject %>",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@jarvis/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "<%= contractProject %>",
    "tags": ["type:contract", "scope:<%= name %>"],
    "projectType": "library"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
