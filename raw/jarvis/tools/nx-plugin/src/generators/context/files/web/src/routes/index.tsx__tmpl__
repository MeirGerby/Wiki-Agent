import { Card } from '@jarvis/ui/components/ui/card';
import { createFileRoute } from '@tanstack/react-router';
import { useEffect } from 'react';
import { useAuth } from '../contexts/auth-context';
import { logInfo } from '../logging/log';

export const Route = createFileRoute('/')({
  component: HomePage,
});

function HomePage() {
  const { user } = useAuth();

  useEffect(() => {
    logInfo({ event: 'page.opened', message: 'Home page opened' });
  }, []);

  return (
    <div className="flex h-svh flex-col gap-4 overflow-hidden bg-background p-4">
      <Card className="min-h-0 flex-1 gap-2 border-line-subtle p-6 shadow-none">
        <h1 className="text-xl font-bold text-foreground"><%= title %></h1>
        <p className="text-muted-foreground">
          {user?.displayName ?? user?.userId ?? ''}
        </p>
      </Card>
    </div>
  );
}
