{
  "name": "<%= webProject %>",
  "$schema": "<%= offsetFromRoot %>node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "<%= projectRoot %>/src",
  "projectType": "application",
  "tags": ["type:web", "scope:<%= name %>"],
  "// targets": "build/serve/preview inferred by @nx/vite/plugin — run: nx show project <%= webProject %> --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "<%= projectRoot %>"
      },
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": ["^build"]
    }
  }
}
